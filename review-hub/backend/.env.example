# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://review_user:review_pass@localhost:5432/review_hub"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── LLM (Anthropic Claude) ──────────────────────────────────────────────────
# Required for AI classification, summarization, and snippet generation
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Naver Search API ────────────────────────────────────────────────────────
# https://developers.naver.com/docs/serviceapi/search/
# Leave empty to disable Naver connector
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── Google Custom Search Engine ─────────────────────────────────────────────
# https://developers.google.com/custom-search/v1/overview
# Leave empty to use mock data (development only)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# ─── Security ────────────────────────────────────────────────────────────────
IP_SALT=change-this-to-random-secret

# ─── Worker ──────────────────────────────────────────────────────────────────
CRAWL_CONCURRENCY=3
